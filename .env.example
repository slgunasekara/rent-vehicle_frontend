VITE_API_URL=http://localhost:5000/api
# Google sign-in (optional - leave empty to hide the Google button)
VITE_GOOGLE_CLIENT_ID=
# Cloudinary cloud name - the home video is played from  https://res.cloudinary.com/<cloud>/video/upload/.../findvehicle/hero.mp4
VITE_CLOUDINARY_CLOUD_NAME=godlwtho
# Or set the full address of any video you want on the home page + login page (overrides the line above)
VITE_HERO_VIDEO_URL=

# the company mailbox shown on the Contact page and footer (same as COMPANY_EMAIL in backend/.env)
VITE_COMPANY_EMAIL=
